# ============================================================
# FRONTEND (salin ke Frontend/.env.local)
# ============================================================

# Google Gemini API untuk Route Handler Next.js (cadangan).
# Jangan pernah memakai nilai ini di kode klien.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL backend FastAPI. Kosongkan bila hanya ingin memakai Route Handler Next.js.
# Bila backend mati, frontend otomatis memakai Route Handler lokal.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (Frontend/.env.local).
# URL berupa origin project, TANPA /rest/v1 di belakangnya.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Hanya anon/publishable key. Jangan pernah memakai service_role key di frontend.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 'local' memakai localStorage; 'supabase' menyinkronkan materi, verifikasi,
# skor kuis, dan pengaturan lewat Supabase. Jalankan Docs/SQL-schema.sql sekali
# di Supabase (termasuk untuk registrasi siswa dan fitur materi guru).
NEXT_PUBLIC_DATA_MODE=local

# ============================================================
# BACKEND FASTAPI (salin ke Backend/.env)
# ============================================================

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# ENVIRONMENT=development
# REQUEST_TIMEOUT_SECONDS=45
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
# Verifikasi token Supabase di backend (off | optional | required).
# AUTH_MODE=optional
# SUPABASE_URL=https://xxxxx.supabase.co
# SUPABASE_JWT_SECRET=   (hanya untuk project HS256 lama)
# MAX_IMAGE_BYTES=10485760
# RATE_LIMIT_REQUESTS=12
# RATE_LIMIT_WINDOW_SECONDS=60
# CACHE_TTL_SECONDS=3600
# CACHE_MAX_ENTRIES=50
# ENABLE_DEMO_FALLBACK=true
