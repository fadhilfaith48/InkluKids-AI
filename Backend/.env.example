# === Gemini (HANYA server, jangan pernah dipakai di kode klien) ===
# Isi dengan API key asli. Selama kosong, endpoint /api/scan akan memberi
# pesan ramah dan aplikasi tetap bisa memakai materi contoh.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Log ringkasan balasan AI untuk diagnosis (tanpa isi gambar/teks halaman).
# Biarkan false saat demo/penilaian.
AI_DEBUG_RAW=false

# === Server ===
ENVIRONMENT=development
REQUEST_TIMEOUT_SECONDS=45

# === CORS (pisahkan dengan koma) ===
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app

# === Verifikasi login (JWT Supabase) ===
# Endpoint AI memverifikasi token Supabase agar kuota Gemini tidak dipakai
# pihak lain.
#   off      = verifikasi dimatikan (hanya untuk pengujian)
#   optional = token diverifikasi bila ada; tamu tetap boleh (demo aman)
#   required = semua permintaan wajib login
AUTH_MODE=optional
SUPABASE_URL=
# Isi HANYA jika project Supabase memakai JWT HS256 (project lama).
# Project baru memakai JWKS otomatis, biarkan kosong.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# === Batas & efisiensi ===
MAX_IMAGE_BYTES=10485760
RATE_LIMIT_REQUESTS=12
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=50

# Saat API key kosong, endpoint /api/explain memakai jawaban contoh aman.
ENABLE_DEMO_FALLBACK=true
